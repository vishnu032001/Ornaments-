# PostgreSQL connection string. Use a pooled runtime URL on serverless providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public application URL used in password-reset links.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email provider (Resend).
RESEND_API_KEY=""
AUTH_FROM_EMAIL="Aurelia Ornaments <no-reply@example.com>"
