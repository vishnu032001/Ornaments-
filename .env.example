# PostgreSQL connection string. Use a pooled runtime URL on serverless providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public application URL.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email provider (Resend).
RESEND_API_KEY=""
AUTH_FROM_EMAIL="Aurelia Ornaments <no-reply@example.com>"

# Stripe production/test keys.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Dynamic checkout pricing (INR). GST rate is configurable; verify the applicable rate before production use.
FREE_SHIPPING_THRESHOLD_INR="2499"
BASE_SHIPPING_INR="99"
PER_KG_SHIPPING_INR="60"
GST_RATE_BPS="300"
